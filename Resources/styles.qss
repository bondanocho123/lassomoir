/* ============================================================
   Palet terang: Coklat primer + Navy sekunder
     Coklat primer  : #a9743f   (aksen utama, tombol, judul stage)
     Coklat muda    : #f2e3d1   (tag kategori, permukaan kolom)
     Navy sekunder  : #33517a   (aksen pendukung, judul task, badge)
     Navy muda      : #e3ebf6
     Krem latar     : #f8f4ee
   ============================================================ */

/* Palet Dasar Aplikasi */
QMainWindow, QWidget#centralwidget, QWidget#centralWidget {
    background-color: #f8f4ee;
    color: #3d3730;
}

/* Container Swimlane */
QScrollArea {
    background-color: transparent;
    border: none;
}

/* Kartu Kanban */
KanbanCardWidget {
    background-color: #ffffff;
    border: 1px solid #e7ddcd;
    border-radius: 6px;
}

KanbanCardWidget:hover {
    border: 1px solid #a9743f;
}

/* Tag Kategori pada Kartu (coklat muda) */
QLabel#labelCategory {
    background-color: #f2e3d1;
    color: #8a5a2f;
    font-size: 10px;
    font-weight: bold;
    border-radius: 3px;
    padding: 1px 6px;
}

/* Badge prioritas pada Kartu (navy muda) */
QLabel#labelBadge {
    background-color: #e3ebf6;
    color: #2f4b73;
    font-size: 10px;
    font-weight: bold;
    border: 1px solid #ccd9ea;
    border-radius: 3px;
    padding: 1px 6px;
}

/* Judul Task pada Kartu (navy sekunder) */
QLabel#labelTitle {
    font-size: 12px;
    font-weight: bold;
    color: #33517a;
}

/* Subteks / Durasi Task */
QLabel#labelSubtext {
    font-size: 10px;
    color: #8a7f70;
}

/* Kolom Stage (krem coklat terang) */
KanbanColumnWidget {
    background-color: #f1e8da;
    border: 1px solid #e2d5c1;
    border-radius: 8px;
}

/* Judul Stage (coklat primer) */
QLabel#labelStageTitle {
    font-size: 10px;
    font-weight: bold;
    color: #a9743f;
    letter-spacing: 0.5px;
}

/* Tombol Header Swimlane - "New Task" (coklat primer solid) */
QPushButton#btnNewTask {
    background-color: #a9743f;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#btnNewTask:hover {
    background-color: #c08a52;
}

QPushButton#btnNewTask:pressed {
    background-color: #8f5f31;
}

/* Tombol Header Swimlane - "Close" (outline navy) */
QPushButton#btnClose {
    background-color: #ffffff;
    color: #33517a;
    border: 1px solid #b9c6da;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#btnClose:hover {
    background-color: #eef2f8;
    border: 1px solid #33517a;
}

QPushButton#btnClose:pressed {
    background-color: #dfe7f2;
}

/* Scrollbar ramping selaras palet */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px 2px 2px 0;
}

QScrollBar::handle:vertical {
    background: #dccbb4;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #a9743f;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}
