/* ============================================================
   Palet terang: Coklat primer + Navy sekunder
     Coklat primer  : #a9743f   (aksen utama, tombol, judul stage)
     Coklat muda    : #f2e3d1   (tag kategori, permukaan kolom)
     Navy sekunder  : #33517a   (aksen pendukung, judul task, badge)
     Navy muda      : #e3ebf6
     Krem latar     : #f8f4ee
   ============================================================ */

/* Font Dasar Aplikasi: seluruh widget memakai gaya Garamond (serif).
   Log kartu konsol (#consoleCardLog), diff, dan branch sengaja dikecualikan
   lewat selector ID-nya sendiri karena tetap butuh font monospace. */
* {
    font-family: "Garamond", "EB Garamond", "Times New Roman", serif;
}

/* Palet Dasar Aplikasi */
QMainWindow, QWidget#centralwidget, QWidget#centralWidget {
    background-color: #f8f4ee;
    color: #3d3730;
}

/* Container Swimlane */
QScrollArea {
    background-color: transparent;
    border: none;
}

/* Kartu Kanban */
KanbanCardWidget {
    background-color: #ffffff;
    border: 1px solid #e7ddcd;
    border-radius: 10px;
}

KanbanCardWidget:hover {
    border: 1px solid #a9743f;
}

/* Status run agent (property "state", lihat KanbanCardWidget::setRunState).
   Ditulis setelah :hover supaya garis status tetap terlihat saat kursor di atas kartu.
   Selama "running" kartu juga berkedip navy (RunPulse, digambar di atas garis ini). */
KanbanCardWidget[state="queued"] {
    border: 1px dashed #33517a;
}

KanbanCardWidget[state="running"] {
    border: 1px solid #33517a;
}

/* Status task di stage-nya (KanbanCardWidget::setTaskState) */
KanbanCardWidget[state="review"] {
    border: 2px solid #b7791f;
}

KanbanCardWidget[state="failed"] {
    border: 1px solid #b4442f;
}

/* Tag Kategori pada Kartu (coklat muda) */
QLabel#labelCategory {
    background-color: #f2e3d1;
    color: #8a5a2f;
    font-size: 10px;
    font-weight: bold;
    border-radius: 3px;
    padding: 1px 6px;
}

/* Badge prioritas pada Kartu (navy muda) */
QLabel#labelBadge {
    background-color: #e3ebf6;
    color: #2f4b73;
    font-size: 10px;
    font-weight: bold;
    border: 1px solid #ccd9ea;
    border-radius: 3px;
    padding: 1px 6px;
}

/* Judul Task pada Kartu (navy sekunder) */
QLabel#labelTitle {
    font-size: 12px;
    font-weight: bold;
    color: #33517a;
}

/* Subteks / Durasi Task */
QLabel#labelSubtext {
    font-size: 10px;
    color: #8a7f70;
}

/* Kolom Stage (krem coklat terang) */
KanbanColumnWidget {
    background-color: #f1e8da;
    border: 1px solid #e2d5c1;
    border-radius: 8px;
}

/* Judul Stage (coklat primer) */
QLabel#labelStageTitle {
    font-size: 10px;
    font-weight: bold;
    color: #a9743f;
    letter-spacing: 0.5px;
}

/* Penjelasan stage saat judul/ikon info di-hover (HoverInfoPopup): kartu putih seperti popup
   folder referensi. Warna nama stage dan subjudulnya ada di StageInfo.cpp (teks kaya). */
QLabel#hoverInfoContent {
    background-color: #ffffff;
    color: #3d3730;
    border: 1px solid #e2d5c1;
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 12px;
}

/* Tooltip biasa ikut skin, bukan kuning bawaan sistem */
QToolTip {
    background-color: #ffffff;
    color: #3d3730;
    border: 1px solid #e2d5c1;
    padding: 3px 6px;
}

/* Tombol Header Swimlane - "Close", folder kerja agent, branch aktif folder kerja, dan folder
   referensi (outline navy) */
QPushButton#btnClose,
QPushButton#btnWorkingDir,
QPushButton#btnBranch,
QPushButton#btnReferenceDirs {
    background-color: #ffffff;
    color: #33517a;
    border: 1px solid #b9c6da;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#btnClose:hover,
QPushButton#btnWorkingDir:hover,
QPushButton#btnBranch:hover,
QPushButton#btnReferenceDirs:hover {
    background-color: #eef2f8;
    border: 1px solid #33517a;
}

QPushButton#btnClose:pressed,
QPushButton#btnWorkingDir:pressed,
QPushButton#btnBranch:pressed,
QPushButton#btnReferenceDirs:pressed {
    background-color: #dfe7f2;
}

/* Penanda lampiran di kartu: "2 foto - 1 file" */
QLabel#labelAttachments {
    font-size: 10px;
    font-weight: bold;
    color: #33517a;
}

/* Scrollbar ramping selaras palet */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px 2px 2px 0;
}

QScrollBar::handle:vertical {
    background: #dccbb4;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #a9743f;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0 2px 2px 2px;
}

QScrollBar::handle:horizontal {
    background: #dccbb4;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #a9743f;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ============ Sidebar daftar project ============ */

QWidget#sidebarPanel {
    background-color: #f7f9f8;
    border: 1px solid #d3d8d5;
    border-radius: 8px;
}

QLabel#labelSidebarTitle {
    font-size: 10px;
    font-weight: bold;
    color: #a9743f;
    letter-spacing: 0.5px;
    padding: 2px 4px;
}

QListWidget#projectList {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#projectList::item {
    padding: 0px;
    border-radius: 5px;
}

QListWidget#projectList::item:hover {
    background-color: #f2e3d1;
}

/* Kedua state dipakai agar project terpilih tetap coklat walau daftar kehilangan fokus */
QListWidget#projectList::item:selected,
QListWidget#projectList::item:selected:!active {
    background-color: #a9743f;
}

/* Baris item project: label (kiri) sejajar justify-between dengan tombol "+" (kanan) */
QWidget#projectRow {
    background: transparent;
}

QLabel#projectRowLabel {
    background: transparent;
    color: #3d3730;
    font-size: 12px;
}

/* Tombol ikon pada baris sidebar: hapus (kiri) + New Task (kanan).
   Hover-nya kotak membulat berlatar gelap; icon-nya ditukar ke versi putih
   lewat eventFilter() di mainwindow.cpp supaya tetap kebaca. */
QPushButton#btnProjectNewTask,
QPushButton#btnProjectDelete {
    background-color: transparent;
    border: none;
    border-radius: 5px;
    padding: 0;
}

QPushButton#btnProjectNewTask:hover,
QPushButton#btnProjectDelete:hover {
    background-color: #3d3730;
}

QPushButton#btnProjectNewTask:pressed,
QPushButton#btnProjectDelete:pressed {
    background-color: #24201b;
}

/* ============ Popup folder referensi (header swimlane) ============ */

QFrame#referencePopup {
    background-color: #ffffff;
    border: 1px solid #e2d5c1;
    border-radius: 8px;
}

QLabel#referencePopupTitle {
    background: transparent;
    font-size: 10px;
    font-weight: bold;
    color: #a9743f;
    letter-spacing: 0.5px;
}

QLabel#referencePopupHint,
QLabel#referencePopupEmpty {
    background: transparent;
    color: #8a7f70;
    font-size: 11px;
}

QWidget#referencePopupContent,
QWidget#referenceRow {
    background: transparent;
}

QLabel#referenceRowName {
    background: transparent;
    color: #33517a;
    font-size: 12px;
    font-weight: bold;
}

QLabel#referenceRowPath {
    background: transparent;
    color: #8a7f70;
    font-size: 10px;
}

QToolButton#btnReferenceRemove {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 3px;
}

QToolButton#btnReferenceRemove:hover {
    background-color: #f2e3d1;
}

QPushButton#btnReferenceAdd {
    background-color: #ffffff;
    color: #33517a;
    border: 1px solid #b9c6da;
    border-radius: 5px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#btnReferenceAdd:hover {
    background-color: #eef2f8;
    border: 1px solid #33517a;
}

/* ============ Menu klik kanan kartu (Edit / Hapus task) ============ */

QMenu#cardContextMenu {
    background-color: #ffffff;
    border: 1px solid #e2d5c1;
    border-radius: 6px;
    padding: 4px 0px;
    font-size: 11px;
    color: #3d3730;
}

QMenu#cardContextMenu::item {
    padding: 5px 16px 5px 12px;
    background: transparent;
}

QMenu#cardContextMenu::item:selected {
    background-color: #f2e3d1;
    color: #3d3730;
}

QMenu#cardContextMenu::separator {
    height: 1px;
    background: #efe6d8;
    margin: 3px 8px;
}

/* ============ Popup konfirmasi hapus project / task ============ */

QFrame#deleteConfirmPopup {
    background-color: #ffffff;
    border: 1px solid #e2d5c1;
    border-radius: 8px;
}

QLabel#deleteConfirmLabel {
    background: transparent;
    color: #3d3730;
    font-size: 11px;
}

QPushButton#btnDeleteConfirmYes,
QPushButton#btnDeleteConfirmCancel {
    border-radius: 5px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#btnDeleteConfirmYes {
    background-color: #a9743f;
    color: #ffffff;
    border: 1px solid #a9743f;
}

QPushButton#btnDeleteConfirmYes:hover {
    background-color: #3d3730;
    border: 1px solid #3d3730;
}

QPushButton#btnDeleteConfirmYes:pressed {
    background-color: #24201b;
    border: 1px solid #24201b;
}

QPushButton#btnDeleteConfirmCancel {
    background-color: #ffffff;
    color: #3d3730;
    border: 1px solid #e2d5c1;
}

QPushButton#btnDeleteConfirmCancel:hover {
    background-color: #3d3730;
    color: #ffffff;
    border: 1px solid #3d3730;
}

QPushButton#btnDeleteConfirmCancel:pressed {
    background-color: #24201b;
    color: #ffffff;
    border: 1px solid #24201b;
}

/* Tombol hamburger pengendali sidebar di top bar */
QPushButton#btnToggleSidebar {
    background: transparent;
    border: none;
    padding: 2px 4px;
}

/* Tombol Run (play hijau) di pojok kanan atas kartu task */
QPushButton#btnCardRun {
    background: transparent;
    border: none;
    padding: 2px 4px;
}
QPushButton#btnCardRun:hover {
    background: #e3ebe6;
    border-radius: 4px;
}

/* Pesan saat belum ada project yang dipilih */
QLabel#labelEmptyState {
    color: #8a7f70;
    font-size: 12px;
}

/* ============ Dialog "New Task" (NewTaskDialog) ============ */

QDialog#NewTaskDialog {
    background-color: #ffffff;
}

QLabel#taskFormSubtitle {
    color: #8a7f70;
    font-size: 11px;
}

QFrame#taskFormDivider {
    background-color: #e2d5c1;
    border: none;
}

/* Label kecil di atas tiap input, gaya sama dengan judul stage kolom kanban */
QLabel#taskFormFieldLabel {
    font-size: 10px;
    font-weight: bold;
    color: #a9743f;
    letter-spacing: 0.5px;
}

QLineEdit#taskFormInput {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 6px 8px;
    font-size: 11px;
    color: #111827;
}

QLineEdit#taskFormInput:focus {
    border: 1px solid #a9743f;
}

QComboBox#taskFormCombo {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 6px 8px;
    font-size: 11px;
    color: #111827;
}

QComboBox#taskFormCombo:focus {
    border: 1px solid #a9743f;
}

QComboBox#taskFormCombo::drop-down {
    border: none;
    width: 20px;
}

QComboBox#taskFormCombo::down-arrow {
    image: none;
    width: 0;
    height: 0;
    margin-right: 8px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #8a7f70;
}

QComboBox#taskFormCombo QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    outline: none;
    selection-background-color: #f2e3d1;
    selection-color: #3d3730;
}

/* Tombol -/+ jumlah approval yang dibutuhkan */
QPushButton#btnTaskFormStepper {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    font-weight: bold;
    color: #3d3730;
}

QPushButton#btnTaskFormStepper:hover {
    background-color: #f2e3d1;
    border: 1px solid #a9743f;
}

QPushButton#btnTaskFormStepper:pressed {
    background-color: #e7ddcd;
}

QLabel#taskFormApprovalsValue {
    border: 1px solid #d1d5db;
    border-radius: 4px;
    font-size: 12px;
    font-weight: bold;
    color: #3d3730;
}

QLabel#taskFormPreviewCaption {
    color: #8a7f70;
    font-size: 10px;
}

/* Kotak prompt (PromptEditor): teks + thumbnail foto + daftar dokumen dalam satu bingkai.
   Property "focused" diatur PromptEditor saat kotak teksnya fokus. */
QFrame#taskPromptBox {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 4px;
}

QFrame#taskPromptBox[focused="true"] {
    border: 1px solid #a9743f;
}

QPlainTextEdit#taskFormPrompt {
    background: transparent;
    border: none;
    padding: 4px 6px;
    font-family: "Segoe UI", sans-serif;
    font-size: 12px;
    color: #111827;
}

QScrollArea#promptImageStrip,
QWidget#promptImageRow,
QWidget#promptDocumentList {
    background: transparent;
    border: none;
}

QToolButton#promptThumb {
    background-color: #fbf8f3;
    border: 1px solid #e2d5c1;
    border-radius: 6px;
    padding: 0;
}

QToolButton#promptThumb:hover {
    border: 1px solid #a9743f;
}

/* Tombol x di pojok thumbnail: bulatan gelap agar terbaca di atas foto apa pun */
QToolButton#btnThumbRemove {
    background-color: rgba(61, 55, 48, 210);
    border: none;
    border-radius: 9px;
    padding: 0;
}

QToolButton#btnThumbRemove:hover {
    background-color: #9b2c1f;
}

QFrame#promptDocument {
    background-color: #fbf8f3;
    border: 1px solid #e7ddcd;
    border-radius: 4px;
}

/* Label jenis dokumen: hijau Excel, biru Word, coklat CSV */
QLabel#promptDocumentKind {
    background-color: #1f7a4d;
    color: #ffffff;
    font-family: "Segoe UI", sans-serif;
    font-size: 9px;
    font-weight: bold;
    border-radius: 3px;
    padding: 1px 4px;
    min-width: 28px;
}

QLabel#promptDocumentKind[kind="word"] {
    background-color: #2b5797;
}

QLabel#promptDocumentKind[kind="csv"] {
    background-color: #8a5a2f;
}

QLabel#promptDocumentName {
    font-size: 11px;
    color: #3d3730;
}

QLabel#promptDocumentSize {
    font-size: 10px;
    color: #8a7f70;
}

QToolButton#btnDocumentRemove {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 3px;
}

QToolButton#btnDocumentRemove:hover {
    background-color: #f2e3d1;
}

QFrame#promptToolbar {
    background: transparent;
    border: none;
    border-top: 1px solid #efe7da;
}

QPushButton#btnPromptAddImage,
QPushButton#btnPromptAddDocument {
    background: transparent;
    color: #33517a;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 3px 8px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#btnPromptAddImage:hover,
QPushButton#btnPromptAddDocument:hover {
    background-color: #eef2f8;
    border: 1px solid #b9c6da;
}

QLabel#promptHint {
    color: #8a7f70;
    font-size: 10px;
}

QLabel#promptHint[error="true"] {
    color: #9b2c1f;
}

/* Pratinjau foto ukuran penuh */
QDialog#imagePreviewDialog {
    background-color: #fbf8f3;
}

QLabel#imagePreview {
    background-color: #ffffff;
    border: 1px solid #e7ddcd;
    border-radius: 6px;
    padding: 6px;
}

QLabel#imagePreviewInfo {
    color: #8a7f70;
    font-size: 11px;
}

QPushButton#btnPreviewRemove,
QPushButton#btnPreviewClose {
    border-radius: 5px;
    padding: 6px 16px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#btnPreviewRemove {
    background-color: #ffffff;
    color: #9b2c1f;
    border: 1px solid #e2c4bd;
}

QPushButton#btnPreviewRemove:hover {
    background-color: #9b2c1f;
    color: #ffffff;
    border: 1px solid #9b2c1f;
}

QPushButton#btnPreviewClose {
    background-color: #a9743f;
    color: #ffffff;
    border: 1px solid #a9743f;
}

QPushButton#btnPreviewClose:hover {
    background-color: #3d3730;
    border: 1px solid #3d3730;
}

QPushButton#btnTaskFormCancel {
    background-color: #ffffff;
    color: #3d3730;
    border: 1px solid #e2d5c1;
    border-radius: 5px;
    padding: 6px 16px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#btnTaskFormCancel:hover {
    background-color: #3d3730;
    color: #ffffff;
    border: 1px solid #3d3730;
}

QPushButton#btnTaskFormCancel:pressed {
    background-color: #24201b;
    color: #ffffff;
    border: 1px solid #24201b;
}

QPushButton#btnTaskFormCreate {
    background-color: #a9743f;
    color: #ffffff;
    border: 1px solid #a9743f;
    border-radius: 5px;
    padding: 6px 16px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#btnTaskFormCreate:hover {
    background-color: #3d3730;
    border: 1px solid #3d3730;
}

QPushButton#btnTaskFormCreate:pressed {
    background-color: #24201b;
    border: 1px solid #24201b;
}

QPushButton#btnTaskFormCreate:disabled {
    background-color: #d9c6ac;
    border: 1px solid #d9c6ac;
    color: #ffffff;
}

/* ============ Drawer hasil agent (ResponseDrawer) ============ */
QWidget#responseDrawer {
    background-color: #fbf8f3;
    border: 1px solid #e2d5c1;
    border-radius: 8px;
}

QLabel#drawerTitle {
    font-size: 14px;
    font-weight: bold;
    color: #33517a;
}

QLabel#drawerStatus,
QLabel#drawerMetrics {
    font-size: 11px;
    color: #6f6557;
}

QLabel#drawerBranch {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    color: #33517a;
}

/* "Lihat commit" di samping nama branch task: jendela branch & commit */
QPushButton#btnDrawerBranchHistory {
    background-color: #ffffff;
    color: #33517a;
    border: 1px solid #b9c6da;
    border-radius: 4px;
    padding: 1px 8px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#btnDrawerBranchHistory:hover {
    background-color: #eef2f8;
    border: 1px solid #33517a;
}

QPushButton#btnDrawerClose,
QPushButton#btnDrawerExpand {
    background: transparent;
    border: none;
    color: #6f6557;
    font-size: 14px;
}

QPushButton#btnDrawerClose:hover,
QPushButton#btnDrawerExpand:hover {
    background-color: #f1e8da;
    border-radius: 4px;
}

/* Dokumen hasil agent dan tab UML: font sans agar dokumen panjang tetap nyaman dibaca */
QTextBrowser#markdownView,
QTextBrowser#umlView {
    background-color: #ffffff;
    border: 1px solid #e7ddcd;
    border-radius: 6px;
    padding: 6px;
    font-family: "Segoe UI", sans-serif;
    font-size: 13px;
    color: #3d3730;
}

QWidget#drawerReviewPanel {
    background-color: #fbeccf;
    border: 1px solid #b7791f;
    border-radius: 6px;
}

QLabel#drawerSectionLabel {
    font-size: 10px;
    font-weight: bold;
    color: #7a4a12;
    letter-spacing: 0.5px;
}

QPlainTextEdit#drawerNote {
    background-color: #ffffff;
    border: 1px solid #e2d5c1;
    border-radius: 4px;
    font-family: "Segoe UI", sans-serif;
    font-size: 12px;
}

QLabel#drawerNoteHint {
    color: #9b2c1f;
    font-size: 11px;
}

/* Setujui = aksi utama (coklat), Revisi/Kembalikan = sekunder (outline navy) */
QPushButton#btnDrawerApprove {
    background-color: #8f5f31;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 5px 12px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#btnDrawerApprove:hover {
    background-color: #7a5024;
}

QPushButton#btnDrawerApprove:pressed {
    background-color: #6a441f;
}

QPushButton#btnDrawerRevise,
QPushButton#btnDrawerSendBack {
    background-color: #ffffff;
    color: #33517a;
    border: 1px solid #b9c6da;
    border-radius: 4px;
    padding: 5px 12px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#btnDrawerRevise:hover,
QPushButton#btnDrawerSendBack:hover {
    background-color: #eef2f8;
    border: 1px solid #33517a;
}

/* Tab drawer di stage peninjauan kode: Hasil agent | Perubahan kode */
QTabBar#drawerTabs::tab {
    background: transparent;
    color: #6f6557;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 4px 10px;
    margin-right: 4px;
    font-size: 12px;
    font-weight: bold;
}

QTabBar#drawerTabs::tab:selected {
    color: #33517a;
    border-bottom: 2px solid #a9743f;
}

QTabBar#drawerTabs::tab:hover:!selected {
    color: #3d3730;
}

/* ============ Perubahan kode (DiffView) ============ */
QLabel#diffSummary {
    font-size: 11px;
    color: #6f6557;
}

QLabel#diffSummary[error="true"] {
    color: #9b2c1f;
}

QPushButton#btnDiffRefresh {
    background-color: #ffffff;
    color: #33517a;
    border: 1px solid #b9c6da;
    border-radius: 4px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#btnDiffRefresh:hover {
    background-color: #eef2f8;
    border: 1px solid #33517a;
}

QPushButton#btnDiffRefresh:disabled {
    color: #b9c6da;
}

/* Satu kolom | Dua kolom: sepasang tombol menempel, yang aktif terisi navy */
QPushButton#btnDiffUnified,
QPushButton#btnDiffSplit {
    background-color: #ffffff;
    color: #33517a;
    border: 1px solid #b9c6da;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#btnDiffUnified {
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    border-right: none;
}

QPushButton#btnDiffSplit {
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QPushButton#btnDiffUnified:hover,
QPushButton#btnDiffSplit:hover {
    background-color: #eef2f8;
}

QPushButton#btnDiffUnified:checked,
QPushButton#btnDiffSplit:checked {
    background-color: #33517a;
    color: #ffffff;
    border-color: #33517a;
}

QTreeWidget#diffFileList {
    background-color: #ffffff;
    border: 1px solid #e7ddcd;
    border-radius: 6px;
    font-family: "Segoe UI", sans-serif;
    font-size: 12px;
    color: #3d3730;
    outline: none;
}

QTreeWidget#diffFileList::item {
    padding: 2px 2px;
}

QTreeWidget#diffFileList::item:hover {
    background-color: #f8f1e6;
}

QTreeWidget#diffFileList::item:selected {
    background-color: #f2e3d1;
    color: #3d3730;
}

/* Diff: font monospace agar kolom nomor baris dan indentasi kode lurus. Dua kolom (sebelum | sesudah)
   wajib berfont sama persis supaya baris kiri dan kanan tetap sejajar. */
QPlainTextEdit#diffText,
QPlainTextEdit#diffOldText,
QPlainTextEdit#diffNewText {
    background-color: #ffffff;
    border: 1px solid #e7ddcd;
    border-radius: 6px;
    font-family: "Cascadia Mono", Consolas, "Courier New", monospace;
    font-size: 12px;
    color: #3d3730;
}

/* ============ Jendela branch & commit (BranchViewer) ============ */
QDialog#branchViewer {
    background-color: #fbf8f3;
}

QWidget#branchToolbar {
    background-color: #fbf8f3;
    border-bottom: 1px solid #e2d5c1;
}

QLabel#branchSectionLabel,
QLabel#branchListTitle {
    font-size: 10px;
    font-weight: bold;
    color: #a9743f;
    letter-spacing: 0.5px;
}

/* Nama branch: monospace seperti nama branch di drawer */
QComboBox#branchSelector,
QComboBox#branchCompareSelector {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 3px 6px;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 12px;
    color: #111827;
    selection-background-color: #f2e3d1;
    selection-color: #3d3730;
}

QComboBox#branchSelector:focus,
QComboBox#branchCompareSelector:focus {
    border: 1px solid #a9743f;
}

/* Kotak ketik pencarian di dalam combo: tanpa aturan ini ia ikut font Garamond dari selector * */
QComboBox#branchSelector QLineEdit,
QComboBox#branchCompareSelector QLineEdit {
    background: transparent;
    border: none;
    padding: 0;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 12px;
    color: #111827;
    selection-background-color: #f2e3d1;
    selection-color: #3d3730;
}

QComboBox#branchSelector:disabled,
QComboBox#branchCompareSelector:disabled {
    color: #b3aa9c;
}

QComboBox#branchSelector::drop-down,
QComboBox#branchCompareSelector::drop-down {
    border: none;
    width: 20px;
}

QComboBox#branchSelector::down-arrow,
QComboBox#branchCompareSelector::down-arrow {
    image: url(:/icons/chevron-down.svg);
    width: 10px;
    height: 10px;
    margin-right: 6px;
}

QComboBox#branchSelector QAbstractItemView,
QComboBox#branchCompareSelector QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    outline: none;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 12px;
    selection-background-color: #f2e3d1;
    selection-color: #3d3730;
}

QToolButton#btnBranchSwap {
    background-color: #ffffff;
    color: #33517a;
    border: 1px solid #b9c6da;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 13px;
    font-weight: bold;
}

QToolButton#btnBranchSwap:hover {
    background-color: #eef2f8;
    border: 1px solid #33517a;
}

QToolButton#btnBranchSwap:disabled {
    color: #c9d3e2;
    border: 1px solid #dfe5ee;
}

QPushButton#btnBranchReload,
QPushButton#btnBranchMore {
    background-color: #ffffff;
    color: #33517a;
    border: 1px solid #b9c6da;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#btnBranchReload:hover,
QPushButton#btnBranchMore:hover {
    background-color: #eef2f8;
    border: 1px solid #33517a;
}

QPushButton#btnBranchReload:disabled,
QPushButton#btnBranchMore:disabled {
    color: #b9c6da;
}

QLabel#branchLocation,
QLabel#branchListMessage {
    font-size: 11px;
    color: #6f6557;
}

QLabel#branchListMessage[error="true"] {
    color: #9b2c1f;
}

/* Baris commit digambar sendiri (BranchViewer.cpp: CommitDelegate) dengan warna palet yang sama */
QTreeWidget#branchCommitList {
    background-color: #ffffff;
    border: 1px solid #e7ddcd;
    border-radius: 6px;
    font-family: "Segoe UI", sans-serif;
    font-size: 12px;
    color: #3d3730;
    outline: none;
}

QLabel#branchDetailTitle {
    font-size: 14px;
    font-weight: bold;
    color: #33517a;
}

QLabel#branchDetailMeta {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    color: #6f6557;
}

QLabel#branchDetailBody {
    background-color: #ffffff;
    border: 1px solid #efe6d8;
    border-radius: 4px;
    padding: 6px 8px;
    font-family: "Segoe UI", sans-serif;
    font-size: 12px;
    color: #3d3730;
}

/* ============ Maintainability Index (MaintainabilityView) ============ */
QLabel#miMessage,
QLabel#miBasis {
    font-size: 11px;
    color: #6f6557;
}

QLabel#miMessage[error="true"] {
    color: #9b2c1f;
}

QWidget#miSummary {
    background-color: #ffffff;
    border: 1px solid #e7ddcd;
    border-radius: 6px;
}

/* Warna skor & rating mengikuti ambang: baik (hijau), sedang (kuning tua), rendah (merah) */
QLabel#miScore {
    font-size: 30px;
    font-weight: bold;
    color: #2f7d32;
}

QLabel#miRating {
    font-size: 13px;
    font-weight: bold;
    color: #2f7d32;
}

QLabel#miScore[rating="moderate"],
QLabel#miRating[rating="moderate"] {
    color: #b7791f;
}

QLabel#miScore[rating="low"],
QLabel#miRating[rating="low"] {
    color: #b3261e;
}

QLabel#miScore[rating="none"],
QLabel#miRating[rating="none"] {
    color: #8a7f70;
}

QLabel#miChange {
    font-size: 12px;
    color: #6f6557;
}

QLabel#miChange[trend="down"] {
    color: #b3261e;
}

QLabel#miChange[trend="up"] {
    color: #2f7d32;
}

QTreeWidget#miFileList {
    background-color: #ffffff;
    border: 1px solid #e7ddcd;
    border-radius: 6px;
    font-family: "Segoe UI", sans-serif;
    font-size: 12px;
    color: #3d3730;
    outline: none;
}

QTreeWidget#miFileList::item {
    padding: 2px 2px;
}

QTreeWidget#miFileList QHeaderView::section {
    background-color: #fbf8f3;
    color: #6f6557;
    border: none;
    border-bottom: 1px solid #e7ddcd;
    padding: 4px 6px;
    font-size: 11px;
    font-weight: bold;
}

QLabel#miLegend {
    font-size: 11px;
    color: #8a7f70;
}

/* ============ Penampil diagram yang bisa di-zoom (DiagramViewer) ============ */
QDialog#diagramViewer {
    background-color: #fbf8f3;
}

QWidget#diagramToolbar {
    background-color: #fbf8f3;
    border-bottom: 1px solid #e2d5c1;
}

/* Tombol zoom: outline navy seperti tombol sekunder drawer; yang aktif (Paskan/100%) terisi navy */
QPushButton#btnDiagramZoomOut,
QPushButton#btnDiagramZoomIn,
QPushButton#btnDiagramFit,
QPushButton#btnDiagramActualSize,
QPushButton#btnDiagramOpenExternal {
    background-color: #ffffff;
    color: #33517a;
    border: 1px solid #b9c6da;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#btnDiagramZoomOut,
QPushButton#btnDiagramZoomIn {
    padding: 0;
    font-size: 16px;
}

QPushButton#btnDiagramZoomOut:hover,
QPushButton#btnDiagramZoomIn:hover,
QPushButton#btnDiagramFit:hover,
QPushButton#btnDiagramActualSize:hover,
QPushButton#btnDiagramOpenExternal:hover {
    background-color: #eef2f8;
    border: 1px solid #33517a;
}

QPushButton#btnDiagramFit:checked,
QPushButton#btnDiagramActualSize:checked {
    background-color: #33517a;
    color: #ffffff;
    border: 1px solid #33517a;
}

QPushButton#btnDiagramZoomOut:disabled,
QPushButton#btnDiagramZoomIn:disabled {
    color: #c9d3e2;
    border: 1px solid #dfe5ee;
}

QLabel#diagramZoomLevel {
    min-width: 46px;
    font-size: 12px;
    font-weight: bold;
    color: #3d3730;
}

QLabel#diagramHint {
    font-size: 11px;
    color: #8a7f70;
}

/* Meja di sekeliling kertas putih diagram (kertas digambar DiagramViewer) */
QGraphicsView#diagramCanvas {
    background-color: #ece5da;
    border: none;
}

/* ============ Daftar task di panel konsol (ConsoleTaskCard) ============ */

/* Garis mengikuti kartu kanban (property "state", lihat ConsoleTaskCard::refreshState);
   selama "running" kartu ikut berkedip navy (RunPulse) */
ConsoleTaskCard {
    background-color: #ffffff;
    border: 1px solid #e7ddcd;
    border-radius: 8px;
}

ConsoleTaskCard:hover {
    border: 1px solid #a9743f;
}

ConsoleTaskCard[state="queued"] {
    border: 1px dashed #33517a;
}

ConsoleTaskCard[state="running"] {
    border: 1px solid #33517a;
}

ConsoleTaskCard[state="review"] {
    border: 1px solid #b7791f;
}

ConsoleTaskCard[state="failed"] {
    border: 1px solid #b4442f;
}

/* Task yang sudah dihapus: tinggal riwayat, dibuat kalem */
ConsoleTaskCard[state="removed"] {
    background-color: #fbf8f3;
    border: 1px dashed #d9cdbb;
}

/* Nama project (coklat muda, seperti tag kategori kartu kanban); kartu Sistem pakai navy muda */
QLabel#consoleCardProject {
    background-color: #f2e3d1;
    color: #8a5a2f;
    font-size: 10px;
    font-weight: bold;
    border-radius: 3px;
    padding: 1px 6px;
}

ConsoleTaskCard[kind="system"] QLabel#consoleCardProject {
    background-color: #e3ebf6;
    color: #2f4b73;
    letter-spacing: 0.5px;
}

QLabel#consoleCardStage {
    font-size: 10px;
    font-weight: bold;
    color: #a9743f;
    letter-spacing: 0.5px;
}

/* Pil status di pojok kanan atas kartu (radius maksimal setengah tinggi label, kalau lebih
   sudutnya malah digambar kotak) */
QLabel#consoleCardStatus {
    font-size: 10px;
    font-weight: bold;
    border-radius: 6px;
    padding: 1px 8px;
}

QLabel#consoleCardStatus[state="running"] {
    background-color: #33517a;
    color: #ffffff;
}

QLabel#consoleCardStatus[state="queued"] {
    background-color: #e3ebf6;
    color: #2f4b73;
}

QLabel#consoleCardStatus[state="review"] {
    background-color: #fbeccf;
    color: #7a4a12;
}

QLabel#consoleCardStatus[state="failed"] {
    background-color: #f6e0db;
    color: #9b2c1f;
}

QLabel#consoleCardStatus[state="done"] {
    background-color: #e3f0e5;
    color: #2f7d32;
}

QLabel#consoleCardStatus[state="removed"] {
    background-color: #efe9e1;
    color: #8a7f70;
}

QLabel#consoleCardTitle {
    font-size: 12px;
    font-weight: bold;
    color: #33517a;
}

/* Sumber notifikasi terakhir (GIT, GATE, CODER, ...) di depan ringkasannya */
QLabel#consoleCardTag {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 9px;
    font-weight: bold;
    color: #a9743f;
}

QLabel#consoleCardSummary {
    font-size: 11px;
    color: #3d3730;
}

QLabel#consoleCardMeta {
    font-size: 10px;
    color: #8a7f70;
}

QToolButton#btnConsoleCardLog {
    background: transparent;
    color: #33517a;
    border: none;
    border-radius: 4px;
    padding: 1px 4px;
    font-size: 10px;
    font-weight: bold;
}

QToolButton#btnConsoleCardLog:hover {
    background-color: #eef2f8;
}

/* Log lengkap task: monospace supaya baris tool & path lurus */
QPlainTextEdit#consoleCardLog {
    background-color: #fafbfb;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    font-family: "Cascadia Code", Consolas, "Courier New", monospace;
    font-size: 10px;
    color: #1f2937;
}
